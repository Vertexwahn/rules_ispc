# GCC 15
build:gcc15 --cxxopt=-std=c++23
build:gcc15 --cxxopt=-Wall
build:gcc15 --define compiler=gcc15
build:gcc15 --cxxopt=-fpermissive

# Visual Studio 2026
build:vs2026 --cxxopt=/std:c++20
build:vs2026 --cxxopt=/Zc:__cplusplus
build:vs2026 --enable_runfiles # https://github.com/bazelbuild/bazel/issues/8843
build:vs2026 --define compiler=vs2026
build:vs2026 --copt=-DWIN32_LEAN_AND_MEAN
build:vs2026 --copt=-DNOGDI
build:vs2026 --host_copt=-DWIN32_LEAN_AND_MEAN
build:vs2026 --host_copt=-DNOGDI

# macOS (e.g. Clang 12.0.0)
build:macos --cxxopt=-std=c++2a
build:macos --cxxopt=-Wall
